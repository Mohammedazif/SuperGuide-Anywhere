{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node", "chrome"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "include": [
    "vitest.config.ts",
    "packages/*/src/**/*.test.ts",
    "packages/*/src/**/*.test.tsx",
    "apps/*/src/**/*.test.ts",
    "apps/*/tsup.config.ts"
  ]
}
