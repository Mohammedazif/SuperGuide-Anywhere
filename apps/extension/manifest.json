{
  "manifest_version": 3,
  "name": "SuperGuide Anywhere",
  "version": "0.1.0",
  "description": "Finishes the task you are stuck on, in the web app you are already using — one site at a time, only where you allow it.",
  "key": "",
  "permissions": ["activeTab", "scripting", "storage"],
  "optional_host_permissions": ["*://*/*"],
  "background": {
    "service_worker": "service-worker.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "SuperGuide Anywhere"
  },
  "options_page": "options.html"
}
